# ────────────────────────────────────────────────────────────────────────
# AQUA-CAST — Environment Configuration
#
# EVERY variable below is OPTIONAL. AQUA-CAST is designed to run perfectly
# out-of-the-box with ZERO configuration: copy this file to `.env`, change
# nothing, and the app boots straight into its high-fidelity local
# simulation engine — live-looking Doppler radar, dynamic water-depth
# accumulation, and flood-aware rerouting — with no API keys, no network
# dependency, and no risk of a live demo breaking on venue wifi.
#
# Add a key below ONLY if you want that specific layer to attempt a real
# live data source on top of the simulation. If a key is missing, wrong,
# rate-limited, or the network drops mid-demo, AQUA-CAST automatically and
# silently falls back to its local engine for that layer — no console
# errors, no broken tiles, no blank map. See src/services/env.js and
# src/services/*Service.js for exactly how each fallback is implemented.
#
# Usage: cp .env.example .env
# ────────────────────────────────────────────────────────────────────────

# --- Master switch --------------------------------------------------------
# Set to "false" to force AQUA-CAST into pure offline-simulation mode,
# regardless of any keys configured below. Recommended for a venue with
# flaky wifi: this guarantees the app makes zero outbound network calls.
VITE_USE_LIVE_APIS=true

# --- Live Weather Radar (RainViewer) ---------------------------------------
# Free, public, and requires NO API key — https://rainviewer.com
# This overlays genuine live global radar imagery on the map as an
# additional realism layer. AQUA-CAST's own flood-depth MATH always uses
# its built-in simulated per-cell radar mosaic (src/lib/radarProxy.js),
# since no public radar API can report reflectivity for a synthetic demo
# neighborhood — RainViewer is purely a visual "is it really raining here
# right now" overlay on top of that.
# Set to "false" to skip this layer entirely (e.g. offline venue).
VITE_RAINVIEWER_ENABLED=true

# --- Live Rainfall Intensity (OpenWeatherMap) ------------------------------
# Get a free key at https://openweathermap.org/api (Current Weather API).
# If left blank, this layer is never even attempted — the top bar simply
# shows AQUA-CAST's own simulated nowcast intensity, which is fully
# self-sufficient on its own.
VITE_OPENWEATHER_API_KEY=

# --- Reference Routing (OSRM) ----------------------------------------------
# Free public demo server, no API key required. Used ONLY as a visual
# "what a normal GPS would say, ignoring the flood" reference overlay.
# AQUA-CAST's actual flood-aware routing ALWAYS runs locally via its own
# Dijkstra engine (src/lib/routing.js) and never depends on this endpoint
# — this variable just lets you point at a self-hosted OSRM instance
# instead of the public demo server, if you have one.
VITE_OSRM_BASE_URL=https://router.project-osrm.org

# --- Network resilience -----------------------------------------------------
# Hard timeout (ms) for every live API call. A slow/dead endpoint can never
# hang the UI — AQUA-CAST falls back a beat early rather than freeze the
# live demo.
VITE_API_TIMEOUT_MS=4000
